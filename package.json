{
  "name": "miestacionamientouc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w @miestacionamientouc/api",
    "dev:admin": "npm run dev -w @miestacionamientouc/admin",
    "dev:mobile": "npm run dev -w @miestacionamientouc/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w @miestacionamientouc/api",
    "db:generate": "npm run db:generate -w @miestacionamientouc/api",
    "db:migrate": "npm run db:migrate -w @miestacionamientouc/api",
    "db:deploy": "npm run db:deploy -w @miestacionamientouc/api"
  }
}
