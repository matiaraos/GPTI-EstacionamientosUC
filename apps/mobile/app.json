{
  "expo": {
    "name": "MiEstacionamientoUC",
    "slug": "miestacionamientouc",
    "scheme": "miestacionamientouc",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "cl.uc.miestacionamiento"
    },
    "android": {
      "package": "cl.uc.miestacionamiento",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B4F9C"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite usar la cámara para leer el código QR de la plaza.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite usar tu ubicación al registrar la llegada a la zona piloto."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B4F9C",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0A0E14"
          }
        }
      ]
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic"
  }
}
