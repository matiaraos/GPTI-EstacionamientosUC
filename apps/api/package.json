{
  "name": "@miestacionamientouc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run db:generate && tsc",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "catalogo:importar": "tsx src/scripts/importar-catalogo.ts",
    "piloto:simular": "tsx src/scripts/simular-piloto.ts",
    "piloto:cerrar": "tsx src/scripts/cerrar-piloto.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-ical": "^0.26.0",
    "nodemailer": "^8.0.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "jest": "^30.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/test/helpers/global-setup.js",
    "testTimeout": 20000
  }
}
