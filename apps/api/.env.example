PORT=3000
ADMIN_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://estacionamientos:estacionamientos_dev@127.0.0.1:5433/estacionamientos
# DIRECT_URL se puede indicar para que Prisma CLI migre mediante una conexión distinta.
# Dominios de correo admitidos para registrarse, separados por comas. La demo usa un dominio ficticio.
ALLOWED_EMAIL_DOMAINS=demo.uc.cl
SESSION_TTL_HOURS=720
# Recuperación de contraseña (01B). El enlace abre la app; en Expo Go usa exp://<IP>:8081/--/restablecer.
RECUPERACION_TTL_MIN=30
RECUPERACION_URL=miestacionamientouc://restablecer
# Correo de prueba con Mailpit (`docker compose up -d mailpit`, bandeja en http://localhost:8025).
# Vacío = los correos se escriben en la consola de la API.
SMTP_URL=smtp://127.0.0.1:1025
CORREO_REMITENTE=MiEstacionamientoUC <no-responder@demo.uc.cl>
# Administrador de prueba que crea `npm run db:seed`. Solo para desarrollo local.
ADMIN_SEED_EMAIL=admin@demo.uc.cl
ADMIN_SEED_PASSWORD=admin-demo-2026
# Ventanas de entrada y salida con QR (05A), en minutos. Valores propuestos, pendientes de confirmar para el piloto.
TOLERANCIA_LLEGADA_MIN=15
TOLERANCIA_SALIDA_MIN=10
# Perímetro donde se admite la llegada. Vacío = perímetro del campus cargado del catálogo.
# Para probar fuera del campus, usa un polígono GeoJSON en una línea, por ejemplo:
# PERIMETRO_PRUEBA={"type":"Polygon","coordinates":[[[-70.66,-33.45],[-70.64,-33.45],[-70.64,-33.43],[-70.66,-33.43],[-70.66,-33.45]]]}
PERIMETRO_PRUEBA=
# Margen en metros alrededor del perímetro para el error del GPS.
MARGEN_PERIMETRO_M=50
