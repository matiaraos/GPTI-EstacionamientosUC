generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bloque de estacionamiento. En San Joaquín cada bloque del catálogo (PARKING-0 a 9) es una zona.
model Zona {
  id        Int              @id @default(autoincrement())
  /// Identificador en el catálogo de origen (Ubícate UC). Nulo para zonas creadas a mano.
  idOrigen  String?          @unique
  nombre    String
  activa    Boolean          @default(true)
  /// Condiciones de acceso publicadas para el bloque.
  acceso    String?
  /// Geometría GeoJSON (Point o Polygon) publicada para el bloque.
  geometria Json?
  plazas    Plaza[]
  horarios  HorarioZona[]
  cercanias CercaniaBloque[]
}

/// Perímetro del campus, usado para validar la llegada (05A).
model Campus {
  id        Int    @id @default(autoincrement())
  idOrigen  String @unique
  nombre    String
  perimetro Json
}

enum TipoDestino {
  sala
  edificio
}

/// Sala o edificio que una persona puede declarar como destino.
model Destino {
  id        Int              @id @default(autoincrement())
  idOrigen  String           @unique
  nombre    String
  tipo      TipoDestino
  pisos     Int[]
  activo    Boolean          @default(true)
  cercanias CercaniaBloque[]
  reservas  Reserva[]

  @@index([nombre])
}

enum MetodoDistancia {
  peatonal
  linea_recta
}

/// Distancia de un bloque a un destino. Las plazas heredan la cercanía de su bloque.
model CercaniaBloque {
  zonaId          Int
  zona            Zona            @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  destinoId       Int
  destino         Destino         @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  metros          Int
  metodo          MetodoDistancia
  conexionBloque  String?
  conexionDestino String?
  /// Posición del bloque para ese destino dentro de su método, según el catálogo.
  orden           Int

  @@id([zonaId, destinoId])
  @@index([destinoId, metodo, metros])
}

/// Horario semanal de apertura en hora de Santiago. `diaSemana`: 1 = lunes … 7 = domingo.
model HorarioZona {
  id           Int  @id @default(autoincrement())
  zonaId       Int
  zona         Zona @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  diaSemana    Int
  /// Minutos desde medianoche (420 = 07:00).
  abreMinuto   Int
  cierraMinuto Int

  @@unique([zonaId, diaSemana])
}

enum TipoPlaza {
  regular
  preferente
}

model Plaza {
  id     Int       @id @default(autoincrement())
  zonaId Int
  zona   Zona      @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  codigo String
  tipo   TipoPlaza @default(regular)
  activa   Boolean   @default(true)
  qrs      QrPlaza[]
  reservas Reserva[]

  @@unique([zonaId, codigo])
}

/// Código QR de una plaza. Hay como máximo uno vigente por plaza (índice parcial en la migración).
model QrPlaza {
  id            Int       @id @default(autoincrement())
  plazaId       Int
  plaza         Plaza     @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  identificador String    @unique
  creadoEn      DateTime  @default(now()) @db.Timestamptz(3)
  revocadoEn    DateTime? @db.Timestamptz(3)
  eventos       EventoReserva[]

  @@index([plazaId])
}

enum Rol {
  usuario
  admin
}

/// Cuenta de la comunidad UC. El correo se guarda normalizado (minúsculas y sin espacios).
model Cuenta {
  id             Int        @id @default(autoincrement())
  correo         String     @unique
  hashContrasena String
  rol            Rol        @default(usuario)
  activa         Boolean    @default(true)
  creadaEn       DateTime   @default(now()) @db.Timestamptz(3)
  vehiculos      Vehiculo[]
  sesiones       Sesion[]
  reservas       Reserva[]
}

/// Vehículo de una cuenta. La patente normalizada lo identifica de forma estable.
model Vehiculo {
  id       Int      @id @default(autoincrement())
  cuentaId Int
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  patente  String   @unique
  creadoEn DateTime @default(now()) @db.Timestamptz(3)
  reservas Reserva[]

  @@index([cuentaId])
}

/// Sesión revocable. Solo se guarda el hash SHA-256 del token entregado al cliente.
model Sesion {
  id         Int       @id @default(autoincrement())
  cuentaId   Int
  cuenta     Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  hashToken  String    @unique
  creadaEn   DateTime  @default(now()) @db.Timestamptz(3)
  venceEn    DateTime  @db.Timestamptz(3)
  revocadaEn DateTime? @db.Timestamptz(3)

  @@index([cuentaId])
}

/// `confirmada` y `en_uso` ocupan capacidad; `finalizada` y `cancelada` la liberan y conservan el historial.
enum EstadoReserva {
  confirmada
  en_uso
  finalizada
  cancelada
}

/// Reserva de una plaza para el intervalo `[inicio, fin)`. Las restricciones de exclusión de la
/// migración impiden que dos reservas que ocupan capacidad se solapen en la misma plaza, cuenta o vehículo.
model Reserva {
  id                Int             @id @default(autoincrement())
  cuentaId          Int
  cuenta            Cuenta          @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  vehiculoId        Int
  vehiculo          Vehiculo        @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  plazaId           Int
  plaza             Plaza           @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  destinoId         Int
  destino           Destino         @relation(fields: [destinoId], references: [id], onDelete: Restrict)
  inicio            DateTime        @db.Timestamptz(3)
  fin               DateTime        @db.Timestamptz(3)
  estado            EstadoReserva   @default(confirmada)
  /// Clave enviada por el cliente para reconocer reintentos de la misma solicitud.
  claveIdempotencia String
  /// Distancia del bloque asignado al destino al momento de reservar.
  metros            Int
  metodoDistancia   MetodoDistancia
  creadaEn          DateTime        @default(now()) @db.Timestamptz(3)
  canceladaEn       DateTime?       @db.Timestamptz(3)
  eventos           EventoReserva[]

  @@unique([cuentaId, claveIdempotencia])
  @@index([cuentaId, inicio])
  @@index([plazaId, inicio])
  @@index([vehiculoId])
  @@index([destinoId])
}

enum TipoEvento {
  entrada
  salida
}

/// Entrada o salida registrada con el QR de la plaza y la hora del servidor. Uno por reserva y tipo.
/// No guarda coordenadas: la ubicación solo se usa para validar la llegada.
model EventoReserva {
  id           Int        @id @default(autoincrement())
  reservaId    Int
  reserva      Reserva    @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  tipo         TipoEvento
  qrPlazaId    Int
  qrPlaza      QrPlaza    @relation(fields: [qrPlazaId], references: [id], onDelete: Restrict)
  registradoEn DateTime   @db.Timestamptz(3)

  @@unique([reservaId, tipo])
  @@index([qrPlazaId])
}
