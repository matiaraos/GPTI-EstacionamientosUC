generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bloque de estacionamiento. En San Joaquín cada bloque del catálogo (PARKING-0 a 9) es una zona.
model Zona {
  id        Int              @id @default(autoincrement())
  /// Identificador en el catálogo de origen (Ubícate UC). Nulo para zonas creadas a mano.
  idOrigen  String?          @unique
  nombre    String
  activa    Boolean          @default(true)
  /// Condiciones de acceso publicadas para el bloque.
  acceso    String?
  /// Geometría GeoJSON (Point o Polygon) publicada para el bloque.
  geometria Json?
  plazas    Plaza[]
  horarios  HorarioZona[]
  cercanias CercaniaBloque[]
}

/// Perímetro del campus, usado para validar la llegada (05A).
model Campus {
  id        Int    @id @default(autoincrement())
  idOrigen  String @unique
  nombre    String
  perimetro Json
}

enum TipoDestino {
  sala
  edificio
}

/// Sala o edificio que una persona puede declarar como destino.
model Destino {
  id               Int               @id @default(autoincrement())
  idOrigen         String            @unique
  nombre           String
  tipo             TipoDestino
  pisos            Int[]
  activo           Boolean           @default(true)
  cercanias        CercaniaBloque[]
  reservas         Reserva[]
  bloquesClase     BloqueClase[]
  desempates       Reserva[]         @relation("DestinoDesempate")
  esperas          SolicitudEspera[] @relation("EsperaDestino")
  esperasDesempate SolicitudEspera[] @relation("EsperaDesempate")

  @@index([nombre])
}

enum MetodoDistancia {
  peatonal
  linea_recta
}

/// Distancia de un bloque a un destino. Las plazas heredan la cercanía de su bloque.
model CercaniaBloque {
  zonaId          Int
  zona            Zona            @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  destinoId       Int
  destino         Destino         @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  metros          Int
  metodo          MetodoDistancia
  conexionBloque  String?
  conexionDestino String?
  /// Posición del bloque para ese destino dentro de su método, según el catálogo.
  orden           Int

  @@id([zonaId, destinoId])
  @@index([destinoId, metodo, metros])
}

/// Horario semanal de apertura en hora de Santiago. `diaSemana`: 1 = lunes … 7 = domingo.
model HorarioZona {
  id           Int  @id @default(autoincrement())
  zonaId       Int
  zona         Zona @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  diaSemana    Int
  /// Minutos desde medianoche (420 = 07:00).
  abreMinuto   Int
  cierraMinuto Int

  @@unique([zonaId, diaSemana])
}

enum TipoPlaza {
  regular
  preferente
}

model Plaza {
  id       Int            @id @default(autoincrement())
  zonaId   Int
  zona     Zona           @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  codigo   String
  tipo     TipoPlaza      @default(regular)
  activa   Boolean        @default(true)
  qrs      QrPlaza[]
  reservas Reserva[]
  bloqueos BloqueoPlaza[]

  @@unique([zonaId, codigo])
}

/// Código QR de una plaza. Hay como máximo uno vigente por plaza (índice parcial en la migración).
model QrPlaza {
  id            Int             @id @default(autoincrement())
  plazaId       Int
  plaza         Plaza           @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  identificador String          @unique
  creadoEn      DateTime        @default(now()) @db.Timestamptz(3)
  revocadoEn    DateTime?       @db.Timestamptz(3)
  eventos       EventoReserva[]

  @@index([plazaId])
}

/// Restricción temporal de una plaza (mantención, evento, incidente). Excluye la plaza de nuevas
/// asignaciones en `[inicio, fin)` mientras no se levante. Se conserva como historial.
model BloqueoPlaza {
  id          Int       @id @default(autoincrement())
  plazaId     Int
  plaza       Plaza     @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  inicio      DateTime  @db.Timestamptz(3)
  fin         DateTime  @db.Timestamptz(3)
  motivo      String
  creadoPorId Int
  creadoPor   Cuenta    @relation("BloqueosCreados", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn    DateTime  @default(now()) @db.Timestamptz(3)
  levantadoEn DateTime? @db.Timestamptz(3)

  @@index([plazaId, inicio])
}

/// Habilitación para usar plazas preferentes (SC-002). Solo guarda el estado administrativo y su
/// vigencia: no se registran certificados ni motivos médicos. Es válida si no está revocada y
/// `vigenteHasta` es posterior al instante evaluado.
model AutorizacionPreferente {
  cuentaId      Int       @id
  cuenta        Cuenta    @relation("Autorizacion", fields: [cuentaId], references: [id], onDelete: Cascade)
  vigenteHasta  DateTime  @db.Timestamptz(3)
  revocadaEn    DateTime? @db.Timestamptz(3)
  otorgadaEn    DateTime  @db.Timestamptz(3)
  otorgadaPorId Int
  otorgadaPor   Cuenta    @relation("AutorizacionesOtorgadas", fields: [otorgadaPorId], references: [id], onDelete: Restrict)

  @@index([otorgadaPorId])
}

/// Bloque del horario semanal de una persona, en hora de Santiago. `diaSemana`: 1 = lunes … 7 = domingo.
/// Los bloques de un mismo día no se solapan (restricción de exclusión en la migración). Editar el
/// horario no cambia las reservas ya confirmadas.
model BloqueClase {
  id           Int      @id @default(autoincrement())
  cuentaId     Int
  cuenta       Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  destinoId    Int
  destino      Destino  @relation(fields: [destinoId], references: [id], onDelete: Restrict)
  diaSemana    Int
  /// Minutos desde medianoche, intervalo `[inicioMinuto, finMinuto)`.
  inicioMinuto Int
  finMinuto    Int
  /// Nombre del curso o actividad, si se conoce (por ejemplo, el SUMMARY del .ics).
  titulo       String?
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  @@index([cuentaId, diaSemana])
  @@index([destinoId])
}

enum Rol {
  usuario
  admin
}

/// Cuenta de la comunidad UC. El correo se guarda normalizado (minúsculas y sin espacios).
model Cuenta {
  id                      Int                      @id @default(autoincrement())
  correo                  String                   @unique
  hashContrasena          String
  rol                     Rol                      @default(usuario)
  activa                  Boolean                  @default(true)
  creadaEn                DateTime                 @default(now()) @db.Timestamptz(3)
  vehiculos               Vehiculo[]
  sesiones                Sesion[]
  reservas                Reserva[]
  recuperaciones          Recuperacion[]
  bloqueosCreados         BloqueoPlaza[]           @relation("BloqueosCreados")
  autorizacion            AutorizacionPreferente?  @relation("Autorizacion")
  autorizacionesOtorgadas AutorizacionPreferente[] @relation("AutorizacionesOtorgadas")
  bloquesClase            BloqueClase[]
  ajustesRanking          AjusteRanking[]          @relation("AjustesRecibidos")
  rectificaciones         AjusteRanking[]          @relation("Rectificaciones")
  solicitudEsperas        SolicitudEspera[]
}

/// Vehículo de una cuenta. La patente normalizada lo identifica de forma estable.
model Vehiculo {
  id               Int               @id @default(autoincrement())
  cuentaId         Int
  cuenta           Cuenta            @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  patente          String            @unique
  creadoEn         DateTime          @default(now()) @db.Timestamptz(3)
  reservas         Reserva[]
  solicitudEsperas SolicitudEspera[]

  @@index([cuentaId])
}

/// Sesión revocable. Solo se guarda el hash SHA-256 del token entregado al cliente.
model Sesion {
  id         Int       @id @default(autoincrement())
  cuentaId   Int
  cuenta     Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  hashToken  String    @unique
  creadaEn   DateTime  @default(now()) @db.Timestamptz(3)
  venceEn    DateTime  @db.Timestamptz(3)
  revocadaEn DateTime? @db.Timestamptz(3)

  @@index([cuentaId])
}

/// Enlace de recuperación de contraseña. Solo se guarda el hash SHA-256 del token enviado por correo.
/// Se consume una sola vez: `usadoEn` marca el uso o la anulación al usarse otro enlace de la cuenta.
model Recuperacion {
  id        Int       @id @default(autoincrement())
  cuentaId  Int
  cuenta    Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  hashToken String    @unique
  creadaEn  DateTime  @default(now()) @db.Timestamptz(3)
  venceEn   DateTime  @db.Timestamptz(3)
  usadoEn   DateTime? @db.Timestamptz(3)

  @@index([cuentaId])
}

/// `confirmada` y `en_uso` ocupan capacidad; el resto la libera y conserva el historial.
/// `ausente`: no registró la llegada dentro de la ventana. `vencida`: no registró la salida a tiempo.
enum EstadoReserva {
  confirmada
  en_uso
  finalizada
  cancelada
  ausente
  vencida
}

/// Reserva de una plaza para el intervalo `[inicio, fin)`. Las restricciones de exclusión de la
/// migración impiden que dos reservas que ocupan capacidad se solapen en la misma plaza, cuenta o vehículo.
model Reserva {
  id                 Int              @id @default(autoincrement())
  cuentaId           Int
  cuenta             Cuenta           @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  vehiculoId         Int
  vehiculo           Vehiculo         @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  plazaId            Int
  plaza              Plaza            @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  destinoId          Int
  destino            Destino          @relation(fields: [destinoId], references: [id], onDelete: Restrict)
  inicio             DateTime         @db.Timestamptz(3)
  fin                DateTime         @db.Timestamptz(3)
  estado             EstadoReserva    @default(confirmada)
  /// Clave enviada por el cliente para reconocer reintentos de la misma solicitud.
  claveIdempotencia  String
  /// Distancia del bloque asignado al destino al momento de reservar.
  metros             Int
  metodoDistancia    MetodoDistancia
  creadaEn           DateTime         @default(now()) @db.Timestamptz(3)
  canceladaEn        DateTime?        @db.Timestamptz(3)
  /// Momento en que el proceso de vencimientos la marcó `ausente` o `vencida`.
  vencidaEn          DateTime?        @db.Timestamptz(3)
  /// Si el destino salió del horario académico (primera clase de la visita) o fue declarado.
  origenDestino      OrigenDestino    @default(declarado)
  /// Destino de la última clase, usado para desempatar bloques (04B).
  destinoDesempateId Int?
  destinoDesempate   Destino?         @relation("DestinoDesempate", fields: [destinoDesempateId], references: [id], onDelete: Restrict)
  /// Reserva original que esta reemplazó al aceptar un cambio. La original queda cancelada.
  reemplazaId        Int?             @unique
  reemplaza          Reserva?         @relation("Cambio", fields: [reemplazaId], references: [id], onDelete: NoAction)
  reemplazadaPor     Reserva?         @relation("Cambio")
  solicitudEspera    SolicitudEspera?
  eventos            EventoReserva[]
  ajustes            AjusteRanking[]

  @@unique([cuentaId, claveIdempotencia])
  @@index([destinoDesempateId])
  @@index([cuentaId, inicio])
  @@index([plazaId, inicio])
  @@index([vehiculoId])
  @@index([destinoId])
}

enum OrigenDestino {
  horario
  declarado
}

enum EstadoEspera {
  pendiente
  asignada
  cancelada
  vencida
}

/// Solicitud en lista de espera, creada solo con el consentimiento de la persona cuando no hubo cupo.
/// Al liberarse capacidad compatible se asigna una sola vez, en la misma transacción que crea la reserva.
model SolicitudEspera {
  id                 Int           @id @default(autoincrement())
  cuentaId           Int
  cuenta             Cuenta        @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  vehiculoId         Int
  vehiculo           Vehiculo      @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  destinoId          Int
  destino            Destino       @relation("EsperaDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  destinoDesempateId Int?
  destinoDesempate   Destino?      @relation("EsperaDesempate", fields: [destinoDesempateId], references: [id], onDelete: Restrict)
  origenDestino      OrigenDestino @default(declarado)
  inicio             DateTime      @db.Timestamptz(3)
  fin                DateTime      @db.Timestamptz(3)
  estado             EstadoEspera  @default(pendiente)
  /// Momento en que la persona aceptó esperar (consentimiento explícito).
  aceptadaEn         DateTime      @db.Timestamptz(3)
  claveIdempotencia  String
  reservaId          Int?          @unique
  reserva            Reserva?      @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  cerradaEn          DateTime?     @db.Timestamptz(3)

  @@unique([cuentaId, claveIdempotencia])
  @@index([estado, inicio])
  @@index([vehiculoId])
  @@index([destinoId])
  @@index([destinoDesempateId])
}

enum TipoAjuste {
  ausencia
  vencimiento
  salida_a_tiempo
  salida_tardia
  rectificacion
}

/// Variación del puntaje de ranking. El puntaje es el valor inicial más la suma de los ajustes.
/// `claveOrigen` identifica el hecho que lo origina (por ejemplo `ausencia:reserva:12`), de modo que
/// cada hecho ajusta el puntaje una sola vez aunque el proceso se repita.
model AjusteRanking {
  id                   Int        @id @default(autoincrement())
  cuentaId             Int
  cuenta               Cuenta     @relation("AjustesRecibidos", fields: [cuentaId], references: [id], onDelete: Restrict)
  reservaId            Int?
  reserva              Reserva?   @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  /// Administrador que registró una rectificación; nulo en los ajustes automáticos.
  autorRectificacionId Int?
  autorRectificacion   Cuenta?    @relation("Rectificaciones", fields: [autorRectificacionId], references: [id], onDelete: Restrict)
  tipo                 TipoAjuste
  claveOrigen          String     @unique
  variacion            Int
  motivo               String
  registradoEn         DateTime   @db.Timestamptz(3)

  @@index([cuentaId, registradoEn])
  @@index([reservaId])
  @@index([autorRectificacionId])
}

enum TipoEvento {
  entrada
  salida
}

/// Entrada o salida registrada con el QR de la plaza y la hora del servidor. Uno por reserva y tipo.
/// No guarda coordenadas: la ubicación solo se usa para validar la llegada.
model EventoReserva {
  id           Int        @id @default(autoincrement())
  reservaId    Int
  reserva      Reserva    @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  tipo         TipoEvento
  qrPlazaId    Int
  qrPlaza      QrPlaza    @relation(fields: [qrPlazaId], references: [id], onDelete: Restrict)
  registradoEn DateTime   @db.Timestamptz(3)

  @@unique([reservaId, tipo])
  @@index([qrPlazaId])
}
